{
  "source": "b2binpay_common 26.1.0 (commit 0521572), Cerberus validator schemas, mainnet patterns only. Entries marked source 'derived' were written for this repository because the upstream package defines no pattern for that chain.",
  "patterns": {
    "btc-legacy": [
      {"pattern": "^1[1-9a-km-zA-HJ-NP-Z]{25,33}$", "source": "b2binpay_common/validators/bitcoin.py:47", "note": "Legacy P2PKH"}
    ],
    "btc-segwit": [
      {"pattern": "^bc1[02-9ac-hj-np-z]{6,87}$", "source": "b2binpay_common/validators/bitcoin.py:43", "note": "bech32, lower case only"},
      {"pattern": "^bc1[02-9ac-hj-np-zAC-HJ-NP-Z]{6,87}$", "source": "b2binpay_common/validators/bitcoin.py:42", "note": "bech32, mixed case allowed"}
